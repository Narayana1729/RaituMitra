rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user has an admin profile in the admins collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if the request is from the owner of the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 👨‍🌾 Farmers Profiles
    match /farmers/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }


    // 💬 Feedback submitted by farmers
    match /feedback/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // 🛡️ Admin accounts (roles are seeded securely, read is allowed for auth check)
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // Admins roles cannot be modified via client SDK
    }

    // 📊 Minimum Support Price lists (MSP)
    match /msp/{docId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can create/update/delete
    }

    // 🌱 Seed inventory listings
    match /seeds/{docId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can create/update/delete
    }

    // 🔔 System alerts and notifications
    match /notifications/{docId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can create/update/delete
    }
  }
}
